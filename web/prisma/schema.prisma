// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agents Agent[]
}

model Agent {
  id                String      @id @default(cuid())
  blockchainAgentId Int?        @unique
  ownerId           String
  name              String
  walletAddress     String?
  dailyLimit        String      @default("10000000") // in USDT wei (6 decimals)
  transactionLimit  String      @default("2000000")  // in USDT wei (6 decimals)
  status            AgentStatus @default(ACTIVE)
  systemPrompt      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  owner        User           @relation(fields: [ownerId], references: [id])
  transactions Transaction[]
  usages       AgentUsage[]
}

model Service {
  id                  String   @id @default(cuid())
  blockchainServiceId Int?     @unique
  providerAddress     String
  name                String
  description         String
  category            String
  price               String   // in USDT wei (6 decimals)
  endpoint            String
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  transactions Transaction[]
}

model Transaction {
  id          String            @id @default(cuid())
  agentId     String
  serviceId   String?
  txHash      String?           @unique
  amount      String            // in USDT wei
  token       String            @default("USDT")
  status      TransactionStatus @default(PENDING)
  errorReason String?
  inputData   String?
  result      String?
  createdAt   DateTime          @default(now())
  confirmedAt DateTime?

  agent   Agent    @relation(fields: [agentId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
}

model AgentUsage {
  id               String   @id @default(cuid())
  agentId          String
  date             DateTime @db.Date
  totalSpent       String   @default("0")
  transactionCount Int      @default(0)

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, date])
}

enum AgentStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  REJECTED
}
